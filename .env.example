# Server Kyra
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# MySQL (buat database terlebih dahulu, lalu jalankan `kyra migrate`)
MYSQL_DSN=kyra:password@tcp(127.0.0.1:3306)/kyra?parseTime=true&charset=utf8mb4&loc=Asia%2FJakarta

# WhatsApp Gateway yang tersedia pada htdocs/whatsapp
WHATSAPP_BASE_URL=http://localhost:5001
WHATSAPP_SESSION=kyra

# Ollama lokal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q8_0

# RajaOngkir. Gunakan endpoint Komerce untuk pilihan tarif termurah lintas kurir.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
STORE_ORIGIN_CITY_ID=
STORE_ORIGIN_ADDRESS=
# Kode kurir internal, dipisahkan titik dua. Kyra memilih tarif termurah otomatis.
RAJAONGKIR_COURIERS=jne:jnt:sicepat:ide:sap:ninja:tiki:lion:anteraja:pos:ncs:rex:rpx:sentral:star:wahana:dse

# Xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
